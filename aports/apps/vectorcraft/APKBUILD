	wayland-libs-egl
	hicolor-icon-theme
	shared-mime-info
	"
subpackages="
	$pkgname-doc
	"
source="vectorcraft-0.23.0.tar.gz::https://github.com/storytold/vectorcraft/archive/refs/tags/v0.23.0.tar.gz"
builddir="$srcdir/vectorcraft-0.23.0"
_craft_app="vectorcraft"
_craft_bins="vectorcraft vectorcraft-cli"
. "$startdir/../craft-common.sh"
