	wayland-libs-egl
	hicolor-icon-theme
	shared-mime-info
	alsa-lib
	"
subpackages="
	$pkgname-doc
	"
source="anicraft-0.1.0.tar.gz::https://github.com/storytold/anicraft/archive/refs/tags/v0.1.0.tar.gz"
builddir="$srcdir/anicraft-0.1.0"
_craft_app="anicraft"
_craft_bins="anicraft anicraft-cli"
. "$startdir/../craft-common.sh"
