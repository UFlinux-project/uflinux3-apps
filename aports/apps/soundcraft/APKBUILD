	rust
	git
	cmake
	samurai
	perl
	desktop-file-utils
	appstream
	alsa-lib-dev
	"
depends="
	wayland-libs-egl
	hicolor-icon-theme
	shared-mime-info
	alsa-lib
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
source="soundcraft-0.20.1.tar.gz::https://github.com/storytold/soundcraft/archive/refs/tags/v0.20.1.tar.gz"
builddir="$srcdir/soundcraft-0.20.1"
_craft_app="soundcraft"
_craft_bins="soundcraft soundcraft-cli"
_craft_man=yes
. "$startdir/../craft-common.sh"
