# chrome-sandbox can use suid when user namespaces aren't available, but uses
# only userns and drops privileges normally.
#
# ## NOTE: net. prepare() really does need a network, so this is not just to
# silence "Go packages require network connection to build": cargo fetches the
# whole gnrt dependency graph from crates.io (tools/crates has no vendor/
# directory), and dawn builds Go with cgo. Everything else is unbundled from
# makedepends.
#
# ## NOTE: !check. ungoogled's domain substitution rewrites the host names the
# net/ and safe_browsing/ tests assert on, and the ungoogled patches drop the
# test-only targets Alpine's check() would run.
options="suid net !check"

export RUSTC_BOOTSTRAP=1

prepare() {
	mkdir -p "$tmpdir" "$GOTMPDIR"
	cd "$builddir" || return 1

	# ## NOTE: the three ungoogled steps run before any Alpine patch, so that
	# Alpine's and copium's patches apply to the tree ungoogled produced. That
	# order is safe: none of the files Alpine or copium patch is a file
	# ungoogled prunes, patches or substitutes.
	msg "Pruning binaries (ungoogled)"
	python3 "$_ug/utils/prune_binaries.py" "$builddir" "$_ug/pruning.list" || return 1

	msg "Applying ungoogled patches"
	python3 "$_ug/utils/patches.py" apply "$builddir" "$_ug/patches" || return 1

	msg "Applying domain substitution"
	python3 "$_ug/utils/domain_substitution.py" apply \
		-r "$_ug/domain_regex.list" \
		-f "$_ug/domain_substitution.list" \
		-c "$srcdir/domsubcache.tar.gz" \
		"$builddir" || return 1

	default_prepare

	_copium_prepare
	_prepare
	_configure
}

_copium_prepare() {
	cd "$builddir" || return 1
	for i in $_copium_patches; do
		case "$i" in
			cbit*.patch)
				msg "${i%::*}"
				patch -p1 -i "$srcdir/copium/$i" -d "$srcdir"/crubit-$_crubit || failed="$failed $i"
				;;
			cr*.patch)
				msg "${i%::*}"
				patch -p1 -i "$srcdir/copium/$i" || failed="$failed $i"
				;;
			*.patch)
				msg "${i%::*}: unknown prefix"
				failed="$failed $i"
				;;
		esac
	done
	if [ -n "$failed" ]; then
		error "The following patches failed to apply:"
		for i in $failed; do
			printf "  %s\n" "$i" >&2
		done
		exit 1
	fi
}

_prepare() {
	cd "$builddir" || return 1
	# why the fuck are there binaries here starting M127? no clue
	msg "Removing the binaries"
	# scanelf prints ar errors on any ar archive spotted.
	# This makes CI go "Job's log exceeded limit of 4194304 bytes.
	# "Job execution will continue but no more output will be collected."
	scanelf -RA -F "%F" "$builddir" 2>/dev/null | while read -r elf; do
		rm -f "$elf"
	done

	rmdir third_party/test_fonts/test_fonts
	ln -s ../../../ third_party/test_fonts/test_fonts

	# https://groups.google.com/a/chromium.org/d/topic/chromium-packagers/9JX1N2nf4PU/discussion
	touch chrome/test/data/webui/i18n_process_css_test.html
	# Use the file at run time instead of effectively compiling in
	sed 's|//third_party/usb_ids/usb.ids|/usr/share/hwdata/usb.ids|g' \
		-i services/device/public/cpp/usb/BUILD.gn

	mkdir -p third_party/node/linux/node-linux-x64/bin
	ln -sv /usr/bin/node third_party/node/linux/node-linux-x64/bin/

	rm -vf third_party/devtools-frontend/src/third_party/esbuild/esbuild
	ln -sv /usr/bin/esbuild third_party/devtools-frontend/src/third_party/esbuild/esbuild
	rm -rv third_party/devtools-frontend/src/node_modules/esbuild
	ln -sv /usr/lib/node_modules/esbuild third_party/devtools-frontend/src/node_modules/esbuild

	# ## NOTE: the directory has to be recreated, not assumed. ungoogled's
	# prune_binaries.py lists third_party/gperf/cipd/ as a contingent CIPD path
	# and empties it, so after it runs the tree has cipd with no bin inside -
	# the prebuilt gperf it held is exactly the binary we are replacing here.
	# blink/renderer/build/scripts/scripts.gni hardcodes the destination as
	# //third_party/gperf/cipd/bin/gperf, so the link has to land there.
	mkdir -p third_party/gperf/cipd/bin
	ln -sv /usr/bin/gperf third_party/gperf/cipd/bin/

	ln -sv /usr/bin/mold buildtools/third_party/mold/cipd/mold

	for _arch in amd64 arm64 arm ""; do
		mkdir -p third_party/dawn/tools/golang/linux-$_arch/bin/
		ln -sv /usr/bin/go third_party/dawn/tools/golang/linux-$_arch/bin/go
	done

	# ## NOTE: Alpine does "rm -r third_party/typescript/linux-amd64/src" here
	# and reads the patch from the 3pp tree next to it. ungoogled prunes that
	# whole directory as a prebuilt binary blob, so the tree is recreated and
	# the patch comes from our own copy. It is vendored as *.patch.noauto, so
	# that default_prepare() does not apply it a second time against $builddir,
	# where lib/lib.dom.d.ts does not exist.
	mkdir -p third_party/typescript/linux-amd64
	cp -r /usr/lib/typescript-go/platform third_party/typescript/linux-amd64/src
	# -i is relative to -d, not cwd
	patch -p1 -i "$srcdir"/typescript_native_preview.patch.noauto -d third_party/typescript/linux-amd64/src/

	mkdir -p buildtools/linux64-format/
	ln -sv /usr/lib/llvm$_llvmver/bin/clang-format buildtools/linux64-format/
	mkdir -p third_party/rust-toolchain/bin
	ln -sv /usr/bin/cargo third_party/rust-toolchain/bin/
	ln -sv /usr/bin/rustc third_party/rust-toolchain/bin/
	ln -sv /usr/bin/rustfmt third_party/rust-toolchain/bin/
	# For gnrt and to build rust std (pretending it's a chromium toolchain) for crubit reasons
	mkdir -p third_party/rust-toolchain/lib
	ln -sv /usr/lib/rustlib third_party/rust-toolchain/lib/rustlib
	# build_crubit needs it in -intermediate
	mkdir -p third_party/rust-toolchain-intermediate
	ln -sv ../../../crubit-$_crubit third_party/rust-toolchain-intermediate/crubit
	env -u CARGO_PROFILE_RELEASE_PANIC python3 ./tools/rust/build_crubit.py --skip-checkout
	# gn workflow needs .gni files from crubit tree
	mkdir -p third_party/rust-toolchain/lib/third_party
	ln -sv ../../../../../crubit-$_crubit third_party/rust-toolchain/lib/third_party/crubit

	rustc -V > third_party/rust-toolchain/VERSION
	#cp third_party/rust-toolchain/VERSION third_party/rust-toolchain/INSTALLED_VERSION

	# ## NOTE: the binary is *not* at tools/crates/gnrt/target/release/gnrt.
	# build.py exports CARGO_TARGET_DIR=/cache/target to share one compiled-crate
	# cache between packages, and that env is inherited here, so cargo writes the
	# executable outside the source tree. Hardcoding ./target made prepare die with
	# "gnrt: not found" right after a build that had plainly succeeded. Ask cargo
	# itself for the target directory instead of assuming the default location.
	local _gnrt_target
	_gnrt_target=$(
		cd tools/crates/gnrt || return 1
		cargo build --locked --release >&2
		cargo metadata --no-deps --format-version 1 |
			python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])'
	)
	[ -x "$_gnrt_target/release/gnrt" ] || {
		error "gnrt was built but not found under '$_gnrt_target/release'"
	}
	# Generates gn workflows for building
	"$_gnrt_target/release/gnrt" gen --for-std third_party/rust-toolchain/lib/rustlib/src/rust

	# reusable system library settings
	# libavif - https://github.com/AOMediaCodec/libavif/commit/50a541469c98009016af8dcc9f83a1be79f3a7d9
	# libaom - https://aomedia.googlesource.com/aom/+/706ee36dcc82%5E%21/
	#   but watch this space: https://aomedia-review.googlesource.com/c/aom/+/188606
	# jsoncpp, re2, snappy, swiftshader-*, woff2 - requires use_custom_libcxx=false
	# icu 76 does not build - https://bugs.gentoo.org/943216
	# highway - reenable after updating to 1.4 https://github.com/google/highway/issues/2705
	local use_system="
		brotli
		crc32c
		dav1d
		double-conversion
		ffmpeg
		flac
		fontconfig
		freetype
		harfbuzz
		libdrm
		libjpeg
		libsecret
		libusb
		libwebp
		libxml
		libxslt
		openh264
		opus
		zlib
		zstd
		"

	for _lib in $use_system libjpeg_turbo unrar; do
		msg "Removing buildscripts for system provided $_lib"
		_lib="${_lib/swiftshader-/swiftshader/third_party/}"
			find . -type f -path "*third_party/$_lib/*" \
			\! -path "*third_party/$_lib/chromium/*" \
			\! -path "*third_party/$_lib/google/*" \
			\! -path './base/third_party/icu/*' \
			\! -path './third_party/libxml/*' \
			\! -path './third_party/pdfium/third_party/freetype/include/pstables.h' \
			\! -path './third_party/crashpad/crashpad/third_party/zlib/zlib_crashpad.h' \
			\! -regex '.*\.\(gn\|gni\|isolate\|py\)' \
			-delete
	done

	msg "Replacing gn files"
	python3 build/linux/unbundle/replace_gn_files.py --system-libraries \
		$use_system
	python3 third_party/libaddressinput/chromium/tools/update-strings.py

	# flatc is used in build workflows since https://crrev.com/c/5595037,
	# but the pre-generated files are still checked-in. remove to make sure
	# they're not used. (if used, they will break builds on version mismatch.)
	# https://github.com/tensorflow/tensorflow/issues/62298
	# find third_party/tflite/ -name '*_generated.h' -delete

	# prevent annoying errors when regenerating gni
	sed -i 's,^update_readme$,#update_readme,' \
		third_party/libvpx/generate_gni.sh

	# allow system dependencies in "official builds"
	sed -i 's/OFFICIAL_BUILD/GOOGLE_CHROME_BUILD/' \
		tools/generate_shim_headers/generate_shim_headers.py

	# https://crbug.com/893950
	sed -i -e 's/\<xmlMalloc\>/malloc/' -e 's/\<xmlFree\>/free/' \
		third_party/blink/renderer/core/xml/*.cc \
		third_party/blink/renderer/core/xml/parser/xml_document_parser.cc \
		third_party/libxml/chromium/*.cc

	echo "$CTARGET" >> build/rust/known-target-triples.txt
}

_configure() {
	cd "$builddir" || return 1

	##############################################################
	# ## NOTE: Alpine keeps its own Google API keys in a base64 blob
	# (google-api.keys). ungoogled ships none, so all three stay empty
	# and use_official_google_api_keys=false. To get sync and the
	# Google services back, create your own keys at
	# http://www.chromium.org/developers/how-tos/api-keys and fill the
	# three arguments in gn_config below.
	##############################################################

	export CFLAGS="${CFLAGS/-g/} -O2 -Wno-unknown-warning-option -Wno-builtin-macro-redefined -Wno-deprecated-declarations -Wno-shift-count-overflow -Wno-ignored-attributes"
	export CXXFLAGS="${CXXFLAGS/-g/} -O2 -Wno-unknown-warning-option -Wno-builtin-macro-redefined -Wno-deprecated-declarations -Wno-invalid-constexpr"
	# _LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE is set by project
	export CXXFLAGS="${CXXFLAGS/-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_FAST/}"
	export CPPFLAGS="${CPPFLAGS/-g/} -D__DATE__=  -D__TIME__=  -D__TIMESTAMP__="

	# breaks chromium
	export CXXFLAGS="${CXXFLAGS/-D_GLIBCXX_ASSERTIONS=1}"
	export CXXFLAGS="${CXXFLAGS/-fstack-clash-protection}"
	export CFLAGS="${CFLAGS/-fstack-clash-protection}"

	export AR="/usr/lib/llvm$_llvmver/bin/llvm-ar"
	export CC="/usr/lib/llvm$_llvmver/bin/clang"
	export CXX="/usr/lib/llvm$_llvmver/bin/clang++"
	export NM="/usr/lib/llvm$_llvmver/bin/llvm-nm"

	msg "Configuring build"

	# this should be at 0 for -dbg too. change it for local debugging only
	local symbol_level=0

	case "$CARCH" in
	riscv64)
		# no vaapi on riscv support
		local vaapi=false
		;;
	*)
		local vaapi=true
		;;
	esac

	case "$CARCH" in
	armv7)
		local gn_threads=--threads=1
		;;
	*)
		local gn_threads=
		;;
	esac

	# Alpine builds without LTO on every arch, which is the right call on the
	# 64-bit builders where the link is already the peak-memory phase. On
	# 32-bit it is the opposite: the single-threaded final link of a non-LTO
	# Chromium is what OOMs an armv7 builder, and ThinLTO is the way out,
	# because it splits the link into per-module parallel passes instead of
	# one whole-program pass (Chromium's own docs put it at 3x-10x faster and
	# far lighter than full LTO). So 64-bit keeps Alpine's setting and 32-bit
	# opts in.
	#
	# ## NOTE: enabling LTO makes Chromium's build assert(use_lld), and
	# use_lld is forced off by the use_mold=true above. A 32-bit build that
	# reaches this branch has to resolve that (drop mold on 32-bit, or pass
	# use_mold=false alongside use_thin_lto=true) before armv7 is added to
	# arch=. No currently enabled arch takes this branch.
	case "$CARCH" in
	x86_64 | aarch64 | riscv64 | ppc64le | s390x)
		local gn_lto=false
		;;
	*)
		local gn_lto=true
		;;
	esac

	case "$USE_CCACHE" in
	1)
		local cc_wrapper="ccache"
		;;
	*)
		local cc_wrapper=""
		;;
	esac

	# Alpine's gn_config with ungoogled's flags.gn merged in: the Google API
	# keys are emptied, enable_hangout_services_extension flips to false, and
	# the keys only ungoogled sets are added in place.
	# shellcheck disable=2089
	local gn_config="
		blink_enable_generated_code_formatting=false
		cc_wrapper=\"$cc_wrapper\"
		chrome_pgo_phase=0
		clang_base_path=\"/usr/lib/llvm$_llvmver\"
		clang_use_chrome_plugins=false
		clang_version=\"$_llvmver\"
		custom_toolchain=\"//build/toolchain/linux/unbundle:default\"
		disable_fieldtrial_testing_config=true
		enable_hangout_services_extension=false
		enable_mdns=false
		enable_nocompile_tests=false
		enable_remoting=false
		enable_reporting=false
		enable_service_discovery=false
		enable_stripping=false
		enable_vr=false
		enable_widevine=true
		exclude_unwind_tables=true
		fatal_linker_warnings=false
		ffmpeg_branding=\"Chrome\"
		google_api_key=\"\"
		google_default_client_id=\"\"
		google_default_client_secret=\"\"
		host_toolchain=\"//build/toolchain/linux/unbundle:default\"
		icu_use_data_file=false
		is_cfi=false
		is_clang=true
		is_component_ffmpeg=true
		is_debug=false
		is_musl=true
		is_official_build=true
		link_pulseaudio=true
		moc_qt6_path=\"/usr/lib/qt6/libexec\"
		node_version_check=false
		proprietary_codecs=true
		rtc_link_pipewire=true
		rtc_use_pipewire=true
		rustc_version=\"yes\"
		rust_bindgen_root=\"/usr\"
		safe_browsing_mode=0
		safe_browsing_use_unrar=false
		symbol_level=$symbol_level
		treat_warnings_as_errors=false
		use_clang_modules=false
		use_custom_libcxx=true
		use_mold=true
		use_official_google_api_keys=false
		use_qt6=true
		use_pulseaudio=true
		use_safe_libstdcxx=false
		use_system_libffi=true
		use_sysroot=false
		use_thin_lto=$gn_lto
		use_unofficial_version_number=false
		use_vaapi=$vaapi
		v8_drumbrake_bounds_checks=true
		v8_use_metagen_instance_types=false
		"

	# shellcheck disable=2090,2116
	gn gen out/bld $gn_threads --args="$(echo $gn_config)"
}

build() {
	msg "Ninja turtles GO!"

	# final link needs lots of file descriptors
	ulimit -n 4096

	# ## NOTE: no '.unstripped' suffix on chromedriver here. Upstream builds it as
	# executable("chromedriver_server.unstripped") (output_name = the file
	# 'chromedriver.unstripped') plus strip_binary("chromedriver_server"), behind
	# 'if (is_linux)', but ungoogled's
	# patches/core/ungoogled-chromium/fix-building-with-prunned-binaries.patch
	# rewrites that guard to 'if (false)' -- the BiDi-CDP mapper it links against is
	# a pruned CIPD tool -- so only the 'else' branch survives and it emits plain
	# 'chromedriver'. Ninja matches a target by name or by output path, so
	# 'chromedriver.unstripped' used to resolve to that output file; with the branch
	# dead nothing produces it and ninja bails out with "unknown target" before a
	# single object file is compiled. The guard is a literal 'false', not a condition
	# on the gn args, so enabling stripping would not bring it back either.
	ninja -C out/bld \
		chrome \
		chrome_sandbox \
		headless_shell \
		chromedriver \
		chrome_crashpad_handler
}

package() {
	cd ./out/bld || return 1

	mkdir -p "$pkgdir"/usr/bin

	# binaries
	install -Dm755 chrome "$pkgdir"/usr/lib/$pkgname/chromium
	# backward compat symlink
	ln -sfv chromium "$pkgdir"/usr/lib/$pkgname/chrome
	install -Dm4755 chrome_sandbox "$pkgdir"/usr/lib/$pkgname/chrome-sandbox
	install -Dm755 chrome_crashpad_handler -t "$pkgdir"/usr/lib/$pkgname/

	# qt6
	install -Dm755 libqt6_shim.so -t "$pkgdir"/usr/lib/$pkgname/

	# chromedriver -- the link output is 'chromedriver'; there is no
	# 'chromedriver.unstripped' in this build (see the note in build()).
	install -Dm755 chromedriver "$pkgdir"/usr/lib/$pkgname/chromedriver
	ln -sfv ../lib/$pkgname/chromedriver "$pkgdir"/usr/bin/chromedriver

	# headless shell
	install -Dm755 headless_shell "$pkgdir"/usr/lib/$pkgname/$pkgname-headless-shell
	ln -sfv ../lib/$pkgname/$pkgname-headless-shell "$pkgdir"/usr/bin/$pkgname-headless-shell

	# resources
	install -Dm644 snapshot_blob.bin -t "$pkgdir"/usr/lib/$pkgname/
	install -Dm644 v8_context_snapshot.bin -t "$pkgdir"/usr/lib/$pkgname/
	if [ -f icudtl.dat ]; then
		install -Dm644 icudtl.dat -t "$pkgdir"/usr/lib/$pkgname/
	fi

	# Vulkan
	install -Dm755 libvulkan.so.1 -t "$pkgdir"/usr/lib/$pkgname/

	# Angle
	install -Dm755 libEGL.so -t "$pkgdir"/usr/lib/$pkgname/
	install -Dm755 libGLESv2.so -t "$pkgdir"/usr/lib/$pkgname/

	install -Dm755 "$srcdir"/web-browser-launcher.sh \
		-t "$pkgdir"/usr/lib/$pkgname/

	# ## NOTE: ungoogled's disable-mei-preload.patch drops the data dependency,
	# so the component is never built and the directory does not exist.
	if [ -d MEIPreload ]; then
		cp -a MEIPreload "$pkgdir"/usr/lib/$pkgname/
	fi

	# ## NOTE: Alpine also installs the names 'chromium' and 'chromium-browser'
	# here, because xdg-utils looks the latter up (bug
	# https://bugs.gentoo.org/355517). We deliberately do not, so that this
	# package can be installed next to Alpine's own chromium; everything points
	# at 'web-browser' instead.
	ln -sfv ../lib/$pkgname/web-browser-launcher.sh "$pkgdir"/usr/bin/$pkgname

	install -Dm644 "$srcdir"/web-browser.conf \
		-t "$pkgdir"/etc/$pkgname/

	for pak in locales/*.pak *.pak; do
		install -Dm644 "$pak" "$pkgdir"/usr/lib/$pkgname/"$pak"
	done

	install -Dm755 libvk_swiftshader.so \
		-t "$pkgdir"/usr/lib/$pkgname/
	install -Dm755 vk_swiftshader_icd.json \
		-t "$pkgdir"/usr/lib/$pkgname/

	cd "$builddir" || return 1

	for size in 24 48 64 128 256; do
		install -Dm644 "chrome/app/theme/chromium/product_logo_$size.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x$size/apps/$pkgname.png"
	done

	for size in 16 32; do
		install -Dm644 "chrome/app/theme/default_100_percent/chromium/product_logo_$size.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x$size/apps/$pkgname.png"
	done

	# ## NOTE: @@MENUNAME is the Name= of the desktop file, ie. the label the
	# user sees in the menu, and @@desktop_icon is 'web-browser' so the icon
	# comes from Papirus rather than from Chromium's own logo.
	sed -i \
		-e 's/@@MENUNAME/Web Browser/g' \
		-e "s/@@PACKAGE/$pkgname/g" \
		-e "s/@@desktop_exec/$pkgname/g" \
		-e 's/@@desktop_icon/web-browser/g' \
		-e "s|@@uri_scheme|x-scheme-handler/$pkgname|g" \
		-e "s/@@usr_bin_symlink_name/$pkgname/g" \
		-e 's/@@startup_wm_class/Chromium/g' \
		-e '/@@extra_desktop_entries/d' \
		chrome/app/resources/manpage.1.in \
		chrome/installer/linux/common/desktop.template

	sed -ni \
		-e 's/@@MENUNAME/Web Browser/g' \
		-e "s/@@PACKAGE/$pkgname/g" \
		-e 's/@@SHORTDESC/Web browser/g' \
		-e 's/@@FULLDESC/An open-source browser project that aims to build a safer, faster, and more stable way to experience the web. This build has the Google parts and the usage telemetry removed./g' \
		-e 's/@@DEVELOPER_NAME/The Chromium Authors/g' \
		-e 's/@@PROJECT_LICENSE/BSD-3-Clause/g' \
		-e '|@@PRODUCTURL|https://www.chromium.org/|g' \
		-e '|@@BUGTRACKERURL|https://github.com/UFlinux-project/uflinux3-apps/issues|g' \
		-e '/@@MAINTMAIL/d' \
		-e '/@@HELPURL/d' \
		-e '/@@appstream_screenshot_url/d' \
		-e '/^<?xml/,$p' \
		chrome/installer/linux/common/appdata.xml.template

	install -Dm644 chrome/installer/linux/common/desktop.template \
		"$pkgdir"/usr/share/applications/$pkgname.desktop
	install -Dm644 chrome/app/resources/manpage.1.in \
		"$pkgdir"/usr/share/man/man1/$pkgname.1
	install -Dm644 chrome/installer/linux/common/appdata.xml.template \
		"$pkgdir"/usr/share/metainfo/$pkgname.appdata.xml
}

common() {
	pkgdesc="Shared resources for main $pkgname package and $pkgname-headless-shell"
	depends="$pkgname-angle=$pkgver-r$pkgrel"

	# en-US is the default, other locales are handled in -lang subpackage
	amove usr/lib/$pkgname/locales/en-US.pak

	amove usr/lib/$pkgname/headless_command_resources.pak \
		usr/lib/$pkgname/v8_context_snapshot.bin
}

qt6() {
	pkgdesc="$pkgname qt6 shim"

	amove usr/lib/$pkgname/libqt6_shim.so
}

chromedriver() {
	pkgdesc="WebDriver driver for $pkgname"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove usr/lib/$pkgname/chromedriver \
		usr/bin/chromedriver
}

headless_shell() {
	pkgdesc="Headless shell providing old headless mode for $pkgname"
	depends="$depends $pkgname-swiftshader=$pkgver-r$pkgrel"

	amove usr/lib/$pkgname/$pkgname-headless-shell \
		usr/bin/$pkgname-headless-shell
	amove usr/lib/$pkgname/headless_*
}

lang() {
	pkgdesc="Languages for package $pkgname"
	install_if="$pkgname=$pkgver-r$pkgrel lang"
	depends=""

	# Default to en-us and provide everything else through the -lang package
	# (en-US is split off in -common subpackage)
	amove usr/lib/$pkgname/locales/*.pak
}

angle() {
	pkgdesc="$pkgname: ANGLE based hardware acceleration"
	depends=""

	amove usr/lib/$pkgname/libEGL.so \
		usr/lib/$pkgname/libGLESv2.so \
		usr/lib/$pkgname/libvulkan.so.1
}

swiftshader() {
	pkgdesc="$pkgname: CPU-based implementation of the Vulkan graphics API"
	depends="$pkgname-angle=$pkgver-r$pkgrel"

	amove usr/lib/$pkgname/libvk_swiftshader.so \
		usr/lib/$pkgname/vk_swiftshader_icd.json
}

