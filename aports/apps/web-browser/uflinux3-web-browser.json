// uflinux3 default enterprise policy for Web Browser.
//
// Installed as a *recommended* policy into /etc/chromium/policies/recommended/,
// which the browser build reads from /etc/chromium/policies (see
// components/policy/core/common/policy_paths.cc: on Linux, non-macOS, non
// Google-Chrome branding this is the base policy dir; config_dir_policy_loader
// .cc then treats the recommended/ subdir as POLICY_LEVEL_RECOMMENDED). Using
// recommended rather than managed means these are defaults the user can still
// change in Settings, without the "Managed by your organization" lock that a
// mandatory policy would impose. The namespaced file name lets this coexist
// with Alpine's own chromium package, which writes into the same directory.
//
// Performance / memory:
//   HighEfficiencyModeEnabled  -> turns Memory Saver on at all.
//   MemorySaverModeSavings = 2 -> aggressiveness "maximum" (kAggressive); the
//                                 UI slider maps 0=conservative, 1=medium,
//                                 2=maximum.
//   NetworkPredictionOptions = 3 -> preloading "extended". The pref enum
//                                 (prefetch::NetworkPredictionOptions) is
//                                 0=standard, 2=disabled, 3=extended; the
//                                 NetworkPredictionOptions policy handler is a
//                                 plain INTEGER with no range clamp, so 3 is
//                                 accepted and surfaces as "Extended
//                                 preloading" in Settings > Performance.
//
// Extensions: pre-installed from the Chrome Web Store but still removable by
// the user ("normal_installed"), pulled from Google's update endpoint.
//   omkfmpieigblcllmkgbflkikinpkodlk -> enhanced-h264ify
//   ddkjiahejlhfcafbddmgiahcphecmpfh -> uBlock Origin Lite (MV3)
{
  "HighEfficiencyModeEnabled": true,
  "MemorySaverModeSavings": 2,
  "NetworkPredictionOptions": 3,
  "ExtensionSettings": {
    "omkfmpieigblcllmkgbflkikinpkodlk": {
      "installation_mode": "normal_installed",
      "update_url": "https://clients2.google.com/service/update2/crx"
    },
    "ddkjiahejlhfcafbddmgiahcphecmpfh": {
      "installation_mode": "normal_installed",
      "update_url": "https://clients2.google.com/service/update2/crx"
    }
  }
}
