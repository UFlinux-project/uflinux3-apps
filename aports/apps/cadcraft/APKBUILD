	wayland-libs-egl
	hicolor-icon-theme
	shared-mime-info
	"
subpackages="
	$pkgname-doc
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
source="cadcraft-0.20.1.tar.gz::https://github.com/storytold/cadcraft/archive/refs/tags/v0.20.1.tar.gz"
builddir="$srcdir/cadcraft-0.20.1"
_craft_app="cadcraft"
_craft_bins="cadcraft cadcraft-cli"
_craft_man=yes
. "$startdir/../craft-common.sh"
