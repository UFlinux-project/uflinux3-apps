	wayland-libs-egl
	hicolor-icon-theme
	shared-mime-info
	fontconfig
	"
subpackages="
	$pkgname-doc
	"
source="wordcraft-0.18.0.tar.gz::https://github.com/storytold/wordcraft/archive/refs/tags/v0.18.0.tar.gz"
builddir="$srcdir/wordcraft-0.18.0"
_craft_app="wordcraft"
_craft_bins="wordcraft wordcraft-cli"
. "$startdir/../craft-common.sh"
