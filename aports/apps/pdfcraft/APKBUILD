	$pkgname-doc
	"
source="pdfcraft-0.21.0.tar.gz::https://github.com/storytold/pdfcraft/archive/refs/tags/v0.21.0.tar.gz"
builddir="$srcdir/pdfcraft-0.21.0"
_craft_app="pdfcraft"
_craft_bins="pdfcraft pdfcraft-cli"
. "$startdir/../craft-common.sh"
